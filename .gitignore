# 根目录的 colcon 输出，包含下划线、连字符等自定义后缀。
# 仅匹配目录；不屏蔽其他位置的构建脚本和源码。
/build*/
/install*/
/log*/

# Python 缓存、离线检查与覆盖率产物。
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# 本地虚拟环境和编辑器配置、交换文件。
.venv/
venv/
/env/
.idea/
.vscode/
*.code-workspace
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ROS 本地配置、录包及运行日志；合同 JSON/YAML 和媒体资源保留可见。
/.ros/
# 面板与实机验证生成的原始反馈、目标时间线和本地报告。
/dummy_reports/
rosbag2_*/
*.bag
*.bag.active
*.db3
*.db3-shm
*.db3-wal
*.mcap
*.log
*.log.*

# 临时目录和文件，不泛化忽略补丁、模板或公开文档。
/tmp/
/temp/
.cache/
*.tmp
*.temp

# 本地 AI 工具及会话计划；已跟踪文件仍需显式取消跟踪。
/.agents/
/.claude/
/.codex/
/docs/superpowers/
