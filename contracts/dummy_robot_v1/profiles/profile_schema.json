{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dummy robot profile",
  "type": "object",
  "required": ["profile_name", "artifact_kind", "source_seed_sha256", "uses_dpsdk_device", "motion_permitted_on_real_hardware"],
  "properties": {
    "profile_name": {"type": "string"},
    "artifact_kind": {"type": "string"},
    "source_seed_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "uses_dpsdk_device": {"type": "boolean"},
    "motion_permitted_on_real_hardware": {"const": false},
    "active_axes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["Joint1", "Joint2", "Joint3", "Joint4", "Joint5", "Joint6"]}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"uses_dpsdk_device": {"const": true}}, "required": ["uses_dpsdk_device"]},
      "then": {"required": ["motion_permitted_on_real_hardware", "active_axes", "profile_id"]}
    }
  ],
  "additionalProperties": true
}
