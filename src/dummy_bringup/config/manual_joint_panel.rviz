# @file manual_joint_panel.rviz
# @brief 手动面板的实际反馈、目标虚影、点位/障碍标记和GUI布局。
# @details 本文件只配置显示订阅与RViz工具，不能通过目标虚影驱动电机。
# 固定坐标base_link；实际与目标描述/TF分开，窗口状态缓存与真实URDF内容也分开。
# 各Panel的Help/Tree Height、Expanded、Splitter只是RViz窗口布局，不是控制参数。
Panels:
- Class: rviz_common/Displays
  Help Height: 78
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    - /Status1
    - /RobotModel1
    - /TF1
    Splitter Ratio: 0.5
  Tree Height: 617
- Class: rviz_common/Selection
  Name: Selection
- Class: rviz_common/Tool Properties
  Expanded:
  - /2D Goal Pose1
  - /Publish Point1
  Name: Tool Properties
  Splitter Ratio: 0.5886790156364441
- Class: rviz_common/Views
  Expanded:
  - /Current View1
  Name: Views
  Splitter Ratio: 0.5
# 显示项按顺序为网格、可信实际模型、TF、目标模型、目标标记及确认的障碍物。
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.5
    Cell Size: 1
    Class: rviz_default_plugins/Grid
    Color: 160; 160; 164
    Enabled: true
    Line Style:
      Line Width: 0.029999999329447746
      Value: Lines
    Name: Grid
    Normal Cell Count: 0
    Offset:
      X: 0
      Y: 0
      Z: 0
    Plane: XY
    Plane Cell Count: 10
    Reference Frame: <Fixed Frame>
    Value: true
  - Alpha: 1
    Class: rviz_default_plugins/RobotModel
    Collision Enabled: false
    Description File: ''
    Description Source: Topic
# 实际模型订阅/measured_robot_description，Reliable+Transient Local保留最近模型给后订阅者。
# Collision Enabled=false只是不画碰撞外形，不能理解为MoveIt碰撞检查已关闭。
    Description Topic:
      Depth: 5
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /measured_robot_description
    Enabled: true
# Links下back/front wheel/motor为历史GUI属性缓存，不创建URDF link或TF，
# 真实六轴结构仍由收到的robot_description决定；每项Alpha/Axes/Trail控制显示。
    Links:
      All Links Enabled: true
      Expand Joint Details: false
      Expand Link Details: false
      Expand Tree: false
      Link Tree Style: Links in Alphabetic Order
      back_motor_left_2:
        Alpha: 1
        Show Axes: false
        Show Trail: false
        Value: true
      back_motor_right_2:
        Alpha: 1
        Show Axes: false
        Show Trail: false
        Value: true
      back_wheel_left_2:
        Alpha: 1
        Show Axes: false
        Show Trail: false
        Value: true
      back_wheel_right_2:
        Alpha: 1
        Show Axes: false
        Show Trail: false
        Value: true
      base_link:
        Alpha: 1
        Show Axes: false
        Show Trail: false
        Value: true
      front_motor_left_2:
        Alpha: 1
        Show Axes: false
        Show Trail: false
        Value: true
      front_motor_right_2:
        Alpha: 1
        Show Axes: false
        Show Trail: false
        Value: true
      front_wheel_left_2:
        Alpha: 1
        Show Axes: false
        Show Trail: false
        Value: true
      front_wheel_right_2:
        Alpha: 1
        Show Axes: false
        Show Trail: false
        Value: true
    Name: 实际姿态（无可信反馈时隐藏）
    TF Prefix: ''
    Update Interval: 0
    Value: true
    Visual Enabled: true
# TF仅显示选定base/link6坐标轴，Frame Timeout为秒，Marker Scale为显示比例。
  - Class: rviz_default_plugins/TF
    Enabled: true
    Frame Timeout: 15
    Frames:
      All Enabled: false
      base_link:
        Value: true
      link6_1_1:
        Value: true
      j6_reducer_housing:
        Value: false
    Marker Scale: 0.3
    Name: TF
    Show Arrows: false
    Show Axes: true
    Show Names: false
    Tree: {}
    Update Interval: 0
    Value: true
# 目标描述走/target_preview/colored_robot_description，TF前缀target_preview，透明度0.4；
# 它与真实反馈是独立显示层，目标存在不表示设备已到位。
  - Class: rviz_default_plugins/RobotModel
    Name: 目标虚影（不驱动实物）
    Enabled: true
    Value: true
    Alpha: 0.4
    Collision Enabled: false
    Visual Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /target_preview/colored_robot_description
      Depth: 1
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
    TF Prefix: target_preview
# 两个MarkerArray分别显示输入目标和已确认碰撞圆柱，Transient Local用于晚加入订阅者。
# RViz收到标记不等于MoveIt场景服务已接受障碍物，需核面板对应确认流程。
  - Class: rviz_default_plugins/MarkerArray
    Name: 目标点位与姿态（输入即显示）
    Enabled: true
    Value: true
    Topic:
      Value: /manual_target_marker
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/MarkerArray
    Name: 已确认碰撞圆柱障碍物
    Enabled: true
    Value: true
    Topic:
      Value: /manual_obstacle_markers
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
  Enabled: true
# 背景/30FPS与后续Orbit距离、视角、裁剪面均是渲染设置，不影响轨迹时序。
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
# 工具栏含initialpose/goal_pose/clicked_point通用发布工具；它们不会自行调用本项目设备执行链。
  Tools:
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: true
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
    Line color: 128; 128; 0
  - Class: rviz_default_plugins/SetInitialPose
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /initialpose
  - Class: rviz_default_plugins/SetGoal
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /goal_pose
  - Class: rviz_default_plugins/PublishPoint
    Single click: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /clicked_point
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 0.8402727246284485
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 0.6097970008850098
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0.5103846192359924
    Saved: null
# 窗口尺寸、位置、Dock折叠与QMainWindow State十六进制是Qt布局缓存；
# 不是设备状态、协议帧、模型SHA或运动授权。
Window Geometry:
  Displays:
    collapsed: false
  Height: 846
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 
  Selection:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: false
  Width: 1200
  X: 201
  Y: 69
