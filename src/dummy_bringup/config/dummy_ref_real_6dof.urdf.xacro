<?xml version="1.0"?>
<!-- @file dummy_ref_real_6dof.urdf.xacro
     @brief 把共享六轴几何与显式身份/限制参数装配为GuardedZenbeddedSystem。
     这里只生成URDF；真正创建硬件插件和连接设备发生在后续ros2_control生命周期。 -->
<robot name="dummy-ros2" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- 视觉/关节模型复用描述包，下面只追加ros2_control接口，不复制另一套几何。 -->
  <xacro:include filename="$(find dummy-ros2_description)/urdf/dummy-ros2.xacro"/>

  <!-- 必填参数默认空，展开时由required_param或内联表达式拒绝空值。
       endpoint为串行/Zenoh定位文本；device/client分别是设备与客户端身份，profile/mask区分角色与活动轴。 -->
  <xacro:arg name="endpoint" default=""/>
  <xacro:arg name="device_id" default=""/>
  <xacro:arg name="client_instance_id" default=""/>
  <xacro:arg name="profile_id" default=""/>
  <xacro:arg name="configured_mask" default=""/>
  <!-- 合同/模型/profile/固件/编译策略摘要必须由选定同版构建与部署输入显式传入；
       非空只是Xacro层前提，格式/身份/能力匹配由传输与插件继续校验。 -->
  <xacro:arg name="contract_sha256" default=""/>
  <xacro:arg name="model_sha256" default=""/>
  <xacro:arg name="profile_sha256" default=""/>
  <xacro:arg name="firmware_sha256" default=""/>
  <xacro:arg name="compiled_policy_sha256" default=""/>
  <!-- 位置上下界用rad，速度rad/s，加速度实义rad/s²（acceleration_max_rad_s为既有名称）。
       六轴数组的具体文本编码由device_transport解析；不能用Xacro非空检查代替有限值/长度校验。 -->
  <xacro:arg name="position_min_rad" default=""/>
  <xacro:arg name="position_max_rad" default=""/>
  <xacro:arg name="velocity_max_rad_s" default=""/>
  <xacro:arg name="acceleration_max_rad_s" default=""/>
  <!-- 控制/状态周期、State最大年龄、心跳停止预算和停止确认预算均用µs。
       stop_confirmation_timeout_us=0显式选择transport的有界默认停止确认预算；
       正数则使用指定预算，负数、后缀及超范围值仍拒绝。 -->
  <xacro:arg name="control_period_us" default=""/>
  <xacro:arg name="state_publish_period_us" default=""/>
  <xacro:arg name="max_state_age_us" default=""/>
  <xacro:arg name="heartbeat_stop_budget_us" default=""/>
  <xacro:arg name="stop_confirmation_timeout_us" default="0"/>
  <xacro:arg name="manual_reference_mode" default="false"/>
  <!-- 可选原始证据输出路径；空字符串时不生成该hardware参数，不等于故障/收尾已被证实。 -->
  <xacro:arg name="raw_evidence_path" default=""/>

  <!-- @brief required_param按key生成param，value为空则以除零使Xacro展开失败。
       key/value是宏文本参数；这里不连接设备、不补猜测身份，也不把0字符串解释为缺省空值。 -->
  <xacro:macro name="required_param" params="key value">
    <param name="${key}">${value if value else 1/0}</param>
  </xacro:macro>

  <!-- system插件拥有一组六轴接口；模型的joint轴/限位来自上方共享Xacro，运行期硬件参数在此显式传递。 -->
  <ros2_control name="dummy_ref_real_6dof" type="system">
    <hardware>
      <plugin>dummy_ros_control/GuardedZenbeddedSystem</plugin>
      <xacro:required_param key="endpoint" value="$(arg endpoint)"/>
      <param name="device_id">${'$(arg device_id)' if '$(arg device_id)' else 1/0}</param>
      <param name="client_instance_id">${'$(arg client_instance_id)' if '$(arg client_instance_id)' else 1/0}</param>
      <xacro:required_param key="profile_id" value="$(arg profile_id)"/>
      <xacro:required_param key="configured_mask" value="$(arg configured_mask)"/>
      <param name="contract_sha256">${'$(arg contract_sha256)' if '$(arg contract_sha256)' else 1/0}</param>
      <param name="model_sha256">${'$(arg model_sha256)' if '$(arg model_sha256)' else 1/0}</param>
      <param name="profile_sha256">${'$(arg profile_sha256)' if '$(arg profile_sha256)' else 1/0}</param>
      <param name="firmware_sha256">${'$(arg firmware_sha256)' if '$(arg firmware_sha256)' else 1/0}</param>
      <param name="compiled_policy_sha256">${'$(arg compiled_policy_sha256)' if '$(arg compiled_policy_sha256)' else 1/0}</param>
      <xacro:required_param key="position_min_rad" value="$(arg position_min_rad)"/>
      <xacro:required_param key="position_max_rad" value="$(arg position_max_rad)"/>
      <xacro:required_param key="velocity_max_rad_s" value="$(arg velocity_max_rad_s)"/>
      <xacro:required_param key="acceleration_max_rad_s" value="$(arg acceleration_max_rad_s)"/>
      <xacro:required_param key="control_period_us" value="$(arg control_period_us)"/>
      <xacro:required_param key="state_publish_period_us" value="$(arg state_publish_period_us)"/>
      <xacro:required_param key="max_state_age_us" value="$(arg max_state_age_us)"/>
      <xacro:required_param key="heartbeat_stop_budget_us" value="$(arg heartbeat_stop_budget_us)"/>
      <param name="stop_confirmation_timeout_us">$(arg stop_confirmation_timeout_us)</param>
      <param name="manual_reference_mode">$(arg manual_reference_mode)</param>
      <xacro:if value="${bool(xacro.arg('raw_evidence_path'))}">
        <param name="raw_evidence_path">$(arg raw_evidence_path)</param>
      </xacro:if>
    </hardware>
  <!-- Joint1..6各只提供position命令，以及position/velocity反馈；
       导出接口不意味着当前已激活、参考有效或permit已签发。 -->
    <joint name="Joint1"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="Joint2"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="Joint3"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="Joint4"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="Joint5"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="Joint6"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
  </ros2_control>
</robot>
