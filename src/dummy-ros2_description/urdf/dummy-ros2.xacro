clearance_base_link是固定、无visual的近端保护体。网格或box沿表面外扩约5.01mm，配套SRDF仅保留规定的近端到腕部检查，不对所有相邻连接统一padding。
-->
<link name="clearance_base_link"><collision>
      <origin rpy="0 0 0" xyz="0.019225 0.000523 -0.004684" />
      <geometry>
        <mesh filename="package://dummy-ros2_description/meshes/full_step_base-collision-local-clearance-5mm.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision></link>
