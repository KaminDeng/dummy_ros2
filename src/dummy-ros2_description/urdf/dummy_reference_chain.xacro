<?xml version="1.0"?>
<!--
@file dummy_reference_chain.xacro
@brief 旧FK公式的数学参考链；每轴采用Rz(q+offset)·Tz(d)·Tx(a)·Rx(alpha)。
@details 无visual/collision；与完整CAD链的用途分开，不能据它验证实体安装、碰撞或机械标定。
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="dummy_reference_chain_macros">
  <!-- Mathematical FK chain generated from dummy model-v1; no visual/collision claims. -->
<!--
@brief 实例化旧求解器的数学参考链，不能替代完整CAD模型。
@param prefix 默认空字符串，应用于每个joint/link名称，供同一模型内多个实例避免重名。
-->
  <xacro:macro name="dummy_reference_chain" params="prefix:=''">
<!--
每轴拆成一个绕局部Z的可动joint与后继固定DH变换；辅助link不含质量、视觉或碰撞，存在只为形成可核对的齐次变换链。
-->
    <link name="${prefix}reference_base"/>
    <link name="${prefix}reference_joint1"/>
    <link name="${prefix}reference_link1"/>
    <link name="${prefix}reference_joint2"/>
    <link name="${prefix}reference_link2"/>
    <link name="${prefix}reference_joint3"/>
    <link name="${prefix}reference_link3"/>
    <link name="${prefix}reference_joint4"/>
    <link name="${prefix}reference_link4"/>
    <link name="${prefix}reference_joint5"/>
    <link name="${prefix}reference_link5"/>
    <link name="${prefix}reference_joint6"/>
    <link name="${prefix}reference_tool"/>

<!--
第1轴的Rz(q+offset)部分，offset=0rad；origin中的固定Z旋转先于q，axis为局部正Z。角度/速度单位rad与rad/s，effort=1只是本数学对照模型的限额元数据。
-->
    <joint name="${prefix}Joint1" type="revolute">
      <parent link="${prefix}reference_base"/><child link="${prefix}reference_joint1"/>
      <axis xyz="0 0 1"/><limit lower="-2.9670597283903604" upper="2.9670597283903604" effort="1" velocity="0.25"/>
    </joint>
<!--
该轴后继Tz(d)·Tx(a)·Rx(alpha)固定变换：d=0.109m、a=0.035m、alpha=−π/2。它不增加可动轴，不是额外电机；本参数来自旧FK数学等价模型，并非当前实物测量。
-->
    <joint name="${prefix}Joint1_dh" type="fixed">
      <parent link="${prefix}reference_joint1"/><child link="${prefix}reference_link1"/>
      <origin xyz="0.035 0 0.109" rpy="-1.5707963267948966 0 0"/>
    </joint>
<!--
第2轴的Rz(q+offset)部分，offset=−π/2rad；origin中的固定Z旋转先于q，axis为局部正Z。角度/速度单位rad与rad/s，effort=1只是本数学对照模型的限额元数据。
-->
    <joint name="${prefix}Joint2" type="revolute">
      <parent link="${prefix}reference_link1"/><child link="${prefix}reference_joint2"/>
      <origin rpy="0 0 -1.5707963267948966"/><axis xyz="0 0 1"/>
      <limit lower="-1.2740903539558606" upper="1.5707963267948966" effort="1" velocity="0.25"/>
    </joint>
<!--
该轴后继Tz(d)·Tx(a)·Rx(alpha)固定变换：d=0、a=0.146m、alpha=0。它不增加可动轴，不是额外电机；本参数来自旧FK数学等价模型，并非当前实物测量。
-->
    <joint name="${prefix}Joint2_dh" type="fixed">
      <parent link="${prefix}reference_joint2"/><child link="${prefix}reference_link2"/>
      <origin xyz="0.146 0 0"/>
    </joint>
<!--
第3轴的Rz(q+offset)部分，offset=+π/2rad；origin中的固定Z旋转先于q，axis为局部正Z。角度/速度单位rad与rad/s，effort=1只是本数学对照模型的限额元数据。
-->
    <joint name="${prefix}Joint3" type="revolute">
      <parent link="${prefix}reference_link2"/><child link="${prefix}reference_joint3"/>
      <origin rpy="0 0 1.5707963267948966"/><axis xyz="0 0 1"/>
      <limit lower="0.6108652381980153" upper="3.141592653589793" effort="1" velocity="0.25"/>
    </joint>
<!--
该轴后继Tz(d)·Tx(a)·Rx(alpha)固定变换：d=0、a=−0.052m、alpha=+π/2。它不增加可动轴，不是额外电机；本参数来自旧FK数学等价模型，并非当前实物测量。
-->
    <joint name="${prefix}Joint3_dh" type="fixed">
      <parent link="${prefix}reference_joint3"/><child link="${prefix}reference_link3"/>
      <origin xyz="-0.052 0 0" rpy="1.5707963267948966 0 0"/>
    </joint>
<!--
第4轴的Rz(q+offset)部分，offset=0rad；origin中的固定Z旋转先于q，axis为局部正Z。角度/速度单位rad与rad/s，effort=1只是本数学对照模型的限额元数据。
-->
    <joint name="${prefix}Joint4" type="revolute">
      <parent link="${prefix}reference_link3"/><child link="${prefix}reference_joint4"/>
      <axis xyz="0 0 1"/><limit lower="-3.141592653589793" upper="3.141592653589793" effort="1" velocity="0.25"/>
    </joint>
<!--
该轴后继Tz(d)·Tx(a)·Rx(alpha)固定变换：d=0.115m、a=0、alpha=−π/2。它不增加可动轴，不是额外电机；本参数来自旧FK数学等价模型，并非当前实物测量。
-->
    <joint name="${prefix}Joint4_dh" type="fixed">
      <parent link="${prefix}reference_joint4"/><child link="${prefix}reference_link4"/>
      <origin xyz="0 0 0.115" rpy="-1.5707963267948966 0 0"/>
    </joint>
<!--
第5轴的Rz(q+offset)部分，offset=0rad；origin中的固定Z旋转先于q，axis为局部正Z。角度/速度单位rad与rad/s，effort=1只是本数学对照模型的限额元数据。
-->
    <joint name="${prefix}Joint5" type="revolute">
      <parent link="${prefix}reference_link4"/><child link="${prefix}reference_joint5"/>
      <axis xyz="0 0 1"/><limit lower="-1.7453292519943295" upper="1.7453292519943295" effort="1" velocity="0.25"/>
    </joint>
<!--
该轴后继Tz(d)·Tx(a)·Rx(alpha)固定变换：d=0、a=0、alpha=+π/2。它不增加可动轴，不是额外电机；本参数来自旧FK数学等价模型，并非当前实物测量。
-->
    <joint name="${prefix}Joint5_dh" type="fixed">
      <parent link="${prefix}reference_joint5"/><child link="${prefix}reference_link5"/>
      <origin rpy="1.5707963267948966 0 0"/>
    </joint>
<!--
第6轴的Rz(q+offset)部分，offset=0rad；origin中的固定Z旋转先于q，axis为局部正Z。角度/速度单位rad与rad/s，effort=1只是本数学对照模型的限额元数据。
-->
    <joint name="${prefix}Joint6" type="revolute">
      <parent link="${prefix}reference_link5"/><child link="${prefix}reference_joint6"/>
      <axis xyz="0 0 1"/><limit lower="-12.566370614359172" upper="12.566370614359172" effort="1" velocity="0.25"/>
    </joint>
<!--
该轴后继Tz(d)·Tx(a)·Rx(alpha)固定变换：d=0.072m、a=0、alpha=0。它不增加可动轴，不是额外电机；本参数来自旧FK数学等价模型，并非当前实物测量。
-->
    <joint name="${prefix}Joint6_dh" type="fixed">
      <parent link="${prefix}reference_joint6"/><child link="${prefix}reference_tool"/>
      <origin xyz="0 0 0.072"/>
    </joint>
  </xacro:macro>
</robot>
