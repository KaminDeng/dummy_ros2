<?xml version="1.0" ?>
<!--
@file dummy-ros2.trans
@brief 历史六轴transmission片段；当前共享Xacro已包含同类声明，此文件并不由其include。
@details 保留原件用于旧导出模型对照；真实ROS2接口以所选ros2_control硬件插件与部署合同为准。
-->
<robot name="dummy-ros2" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<!--
Joint1的旧SimpleTransmission元数据；joint与actuator分别描述关节侧和执行器侧的EffortJointInterface。reduction=1不代表真实驱动减速比，也不会为当前ROS2创建位置命令接口。
-->
<transmission name="Joint1_tran">
  <type>transmission_interface/SimpleTransmission</type>
  <joint name="Joint1">
    <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
  </joint>
  <actuator name="Joint1_actr">
    <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    <mechanicalReduction>1</mechanicalReduction>
  </actuator>
</transmission>

<!--
Joint2的旧SimpleTransmission元数据；joint与actuator分别描述关节侧和执行器侧的EffortJointInterface。reduction=1不代表真实驱动减速比，也不会为当前ROS2创建位置命令接口。
-->
<transmission name="Joint2_tran">
  <type>transmission_interface/SimpleTransmission</type>
  <joint name="Joint2">
    <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
  </joint>
  <actuator name="Joint2_actr">
    <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    <mechanicalReduction>1</mechanicalReduction>
  </actuator>
</transmission>

