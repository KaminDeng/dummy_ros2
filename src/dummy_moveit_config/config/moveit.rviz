# @file moveit.rviz
# @brief 通用MoveIt MotionPlanning插件布局，保存显示话题、坐标系及窗口状态。
# 侧栏面板与展开状态属于GUI布局，不是机器人模型或设备参数。
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /MotionPlanning1
  - Class: rviz_common/Help
    Name: Help
  - Class: rviz_common/Views
    Name: Views
# 显示插件从话题/参数读取模型和场景；加载插件不等于底层服务/状态已经就绪。
Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Value: true
    - Class: moveit_rviz_plugin/MotionPlanning
      Name: MotionPlanning
# 显示规划轨迹与循环动画；这里看到的虚拟轨迹不证明实际执行，Scene Robot/实际关节反馈还要另外观察。
      Planned Path:
        Loop Animation: true
        State Display Time: 0.05 s
        Trajectory Topic: display_planned_path
      Planning Scene Topic: monitored_planning_scene
      Robot Description: robot_description
      Scene Geometry:
        Scene Alpha: 1
      Scene Robot:
        Robot Alpha: 0.5
      Value: true
# Fixed Frame是渲染统一坐标系；必须能通过TF连接各显示源，改它不会改变设备机械零点。
  Global Options:
    Fixed Frame: world
# 交互、相机与选择等工具；若工具配置了话题，点击时可发布相应ROS消息，但不直接建立DPSDK运动授权。
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
# Orbit距离/焦点/角度只控制摄像机视角；角度不能当成Joint1至Joint6目标。
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.0
      Focal Point:
        X: -0.1
        Y: 0.25
        Z: 0.30
      Name: Current View
      Pitch: 0.5
      Target Frame: world
      Yaw: -0.623
# 窗口大小、位置与Qt序列化布局；QMainWindow State长串是GUI状态，不是固件、编码器或运动证据。
Window Geometry:
  Height: 975
  QMainWindow State: 
  Width: 1200
