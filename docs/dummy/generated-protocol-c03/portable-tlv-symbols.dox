/**
 * @fn void dp::iface::tlv::detail::put_u16(uint8_t *output, uint16_t value)
 * @brief 写入低字节在先的16位整数。
 *
 * 调用方保证指针有效和至少2字节范围；helper自身不做空指针/容量/语义检查，也不发送数据。
 * @param output 借用可写缓冲或结果对象；具体角色由函数签名/本段流程说明，返回后不保留。
 * @param value 待存标量或视图，单位/身份含义与对应字段一致。
 * @return 无返回值。
 */

/**
 * @fn uint16_t dp::iface::tlv::detail::get_u16(const uint8_t *input)
 * @brief 读取低字节在先的16位整数。
 *
 * 调用方保证指针有效和至少2字节范围；helper自身不做空指针/容量/语义检查，也不发送数据。
 * @param input 借用只读输入缓冲，调用期间须覆盖声明的字节范围；不保留指针。
 * @return 还原无符号整数位值。
 */

/**
 * @fn bool dp::iface::tlv::detail::reserve(size_t capacity, size_t *used, size_t length)
 * @brief 预留TLV条目的容量并推进游标。
 *
 * 查length<=65535、当前游标<=capacity及剩余足4+length，失败不推进；不核指针空/真实内存，reserve只计数不写，append写小端tag16/length16。不禁止tag0，正式encoder使用固定非零tag。
 * @param capacity 借用缓冲实际容量字节数；不分配内存。
 * @param used 非空已用字节游标/输出长度指针，可能先清0或逐步推进，见本函数流程。
 * @param length 本TLV字段payload字节数，低层要求不超过uint16可表示范围。
 * @return reserve成功true/失败false。
 */

/**
 * @fn uint8_t * dp::iface::tlv::detail::append(uint8_t *output, size_t capacity, size_t *offset, uint16_t tag, size_t length)
 * @brief 追加4字节TLV头并返回payload槽。
 *
 * 查length<=65535、当前游标<=capacity及剩余足4+length，失败不推进；不核指针空/真实内存，reserve只计数不写，append写小端tag16/length16。不禁止tag0，正式encoder使用固定非零tag。
 * @param output 借用可写缓冲或结果对象；具体角色由函数签名/本段流程说明，返回后不保留。
 * @param capacity 借用缓冲实际容量字节数；不分配内存。
 * @param offset 字节游标输入输出指针或raw base内字节偏移；见类型，不是时间。
 * @param tag TLV或Protobuf字段数值tag，不是schema/interface ID。
 * @param length 本TLV字段payload字节数，低层要求不超过uint16可表示范围。
 * @return 成功返回借用payload地址并推进offset；失败nullptr。
 */

/**
 * @fn void dp::iface::tlv::detail::put_scalar(uint8_t *output, T value)
 * @brief 将整数/IEEE浮点标量写为小端位模式。
 *
 * 编译期约束类型和1/2/4/8宽；bool写0/1，浮点通过memcpy位转换。不查指针容量、不拒绝NaN。
@tparam T 受实现静态约束的整数/IEEE浮点类型；类型决定wire宽度，bool单字节0/1。
 * @param output 借用可写缓冲或结果对象；具体角色由函数签名/本段流程说明，返回后不保留。
 * @param value 待存标量或视图，单位/身份含义与对应字段一致。
 * @return 无返回值。
 */

/**
 * @fn bool dp::iface::tlv::detail::get_scalar(const uint8_t *input, size_t length, T *value)
 * @brief 按精确sizeof(T)解码标量。
 *
 * length不等sizeof或value空则拒绝；bool需0/1，其它整数/浮点按小端位还原，不查input空/实际范围或NaN。
@tparam T 受实现静态约束的整数/IEEE浮点类型；类型决定wire宽度，bool单字节0/1。
 * @param input 借用只读输入缓冲，调用期间须覆盖声明的字节范围；不保留指针。
 * @param length 本TLV字段payload字节数，低层要求不超过uint16可表示范围。
 * @param value 待存标量或视图，单位/身份含义与对应字段一致。
 * @return 成功true并写value，否则false。
 */

/**
 * @typedef dp::iface::tlv::Codec< dp::iface::CapabilityAnnounceV1 >::Value
 * @brief 本作用域实际类型别名/回调签名。
 *
 * 原声明：using dp::iface::tlv::Codec&lt; dp::iface::CapabilityAnnounceV1 &gt;::Value =  dp::iface::CapabilityAnnounceV1。别名不创建对象、延长借用寿命或启用服务；回调的指针/字节范围约定沿用对应encoder/decoder。
 */

/**
 * @var dp::iface::tlv::Codec< dp::iface::CapabilityAnnounceV1 >::kMaxEncodedSize
 * @brief 本codec的wire尺寸/上限、scratch对象需求、ABI对齐或声明年龄预算。
 *
 * 字节/对齐以bytes计；kMaxAge在zenbedded为毫秒声明且codec不测时间。TLV scratch为sizeof(Value)，固定codec scratch=0仍可有局部变量；不能用对象sizeof代wire长度。
原声明类型：constexpr size_t；初始化表达式：= 48U。
 */

/**
 * @var dp::iface::tlv::Codec< dp::iface::CapabilityAnnounceV1 >::kScratchSize
 * @brief 本codec的wire尺寸/上限、scratch对象需求、ABI对齐或声明年龄预算。
 *
 * 字节/对齐以bytes计；kMaxAge在zenbedded为毫秒声明且codec不测时间。TLV scratch为sizeof(Value)，固定codec scratch=0仍可有局部变量；不能用对象sizeof代wire长度。
原声明类型：constexpr size_t；初始化表达式：= sizeof(Value)。
 */

/**
 * @var dp::iface::tlv::Codec< dp::iface::CapabilityAnnounceV1 >::kAlignment
 * @brief 本codec的wire尺寸/上限、scratch对象需求、ABI对齐或声明年龄预算。
 *
 * 字节/对齐以bytes计；kMaxAge在zenbedded为毫秒声明且codec不测时间。TLV scratch为sizeof(Value)，固定codec scratch=0仍可有局部变量；不能用对象sizeof代wire长度。
原声明类型：constexpr size_t；初始化表达式：= alignof(Value)。
 */

/**
 * @var dp::iface::tlv::Codec< dp::iface::CapabilityAnnounceV1 >::kInterfaceId
 * @brief 锁定消息/service/request/response接口数值ID，无单位。
 *
 * 同ID可对应不同profile编码，不能仅凭数值选择raw或TLV；不是CAN节点或已注册服务。
原声明类型：constexpr uint32_t；初始化表达式：= 4101U。
 */

/**
 * @fn static bool dp::iface::tlv::Codec< dp::iface::CapabilityAnnounceV1 >::encode(const Value &message, uint8_t *output, size_t capacity, size_t *used)
 * @brief 按本类型稳定tag编码有界TLV。
 *
 * 先要求used非空并清0，output非空；reserve预计算所有字段4字节tag/len头+payload，限制单字段uint16长与本类型kMaxEncodedSize，随后顺序输出全部字段（包括optional默认值）。本类型tag/尺寸/required位见类型说明。正常容量拒绝发生在写前；不检查schema、权限、NaN、CRC或跨字段语义；不保存指针。
 * @param message 借用消息值对象；const为读入，非const为写入；caller保证正确类型和完整内存。
 * @param output 借用可写缓冲或结果对象；具体角色由函数签名/本段流程说明，返回后不保留。
 * @param capacity 借用缓冲实际容量字节数；不分配内存。
 * @param used 非空已用字节游标/输出长度指针，可能先清0或逐步推进，见本函数流程。
 * @return 成功true并写*used；false时*used=0，caller不得使用未提交缓冲。
 */

/**
 * @fn static bool dp::iface::tlv::Codec< dp::iface::CapabilityAnnounceV1 >::decode(const uint8_t *input, size_t size, Value *output, Value *scratch)
 * @brief 用独立scratch解析本类型TLV并一次提交。
 *
 * 拒绝空指针、output==scratch、size>65535；不另要求size<=kMaxEncodedSize，所以允许附加未知字段。清scratch后逐条查4字节头、tag非0、length不越输入尾；未知tag跳过，已知tag重复/标量长度/固定数组长度/有界容量/bool非0或1均拒绝，最后核本类型required位。optional缺省为0/空。全部通过后*output=*scratch；失败保output但scratch可能改变。无SHA/CRC/认证/新鲜度或业务枚举范围检查；部分重叠内存由caller避免。
 * @param input 借用只读输入缓冲，调用期间须覆盖声明的字节范围；不保留指针。
 * @param size 输入/固定wire字节数，不是对象sizeof或元素条数。
 * @param output 借用可写缓冲或结果对象；具体角色由函数签名/本段流程说明，返回后不保留。
 * @param scratch 独立且不与output同地址的Value临时对象；解码会清零并逐步写，拒绝时scratch可改变。
 * @return 成功true，任何格式/必填/容量门失败false。
 */

/**
 * @typedef dp::iface::tlv::Codec< dp::iface::CapabilityBitmapV1 >::Value
 * @brief 本作用域实际类型别名/回调签名。
 *
 * 原声明：using dp::iface::tlv::Codec&lt; dp::iface::CapabilityBitmapV1 &gt;::Value =  dp::iface::CapabilityBitmapV1。别名不创建对象、延长借用寿命或启用服务；回调的指针/字节范围约定沿用对应encoder/decoder。
