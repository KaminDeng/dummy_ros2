/**
 * @fn constexpr const char * dp::protocol::capabilities::capability_name(uint16_t id)
 * @brief 按稳定能力ID线性查名称。
 *
 * 只遍历18个catalog行；返回静态字符串或nullptr，不生成能力。
 * @param id 能力ID输入或输出；稳定编号1起，见指针类型。
 * @return 找到的静态名称指针，程序寿命；未知ID为nullptr。
 */

/**
 * @fn bool dp::protocol::capabilities::capability_id(std::string_view name, uint16_t *id)
 * @brief 按精确string_view名称查稳定ID。
 *
 * out id必须非空；比较含显式长度，失败不改*id，不做认证。
 * @param name 借用string_view精确能力名称，底层字符须在比较期间存活。
 * @param id 能力ID输入或输出；稳定编号1起，见指针类型。
 * @return 成功true并写ID，未知名/空输出false。
 */

/**
 * @fn bool dp::protocol::capabilities::set_capability(CatalogBitmap *bitmap, std::string_view name)
 * @brief 按名称置catalog位图的一个能力位。
 *
 * 先查已知ID，再置bit(id-1)；不清其它位，不提供原子并发写或运行资格。
 * @param bitmap 借用16字节CatalogBitmap；set写一个位，has只读，不提供并发同步。
 * @param name 借用string_view精确能力名称，底层字符须在比较期间存活。
 * @return 名称有效且bitmap非空为true，否则false。
 */

/**
 * @fn constexpr bool dp::protocol::capabilities::has_capability(const CatalogBitmap &bitmap, uint16_t id)
 * @brief 读取1起编号能力的位图位。
 *
 * 拒绝ID0及大于128，但未要求ID存在18项catalog；保留位非零也可返回true。
 * @param bitmap 借用16字节CatalogBitmap；set写一个位，has只读，不提供并发同步。
 * @param id 能力ID输入或输出；稳定编号1起，见指针类型。
 * @return 相应位是否置位；越界false。
 */

/**
 * @var dp::protocol::legacy::kDpProtocolLegacyPayloadDpCrashCrashAnnounceRawFixedV1Schema
 * @brief schema名称/来源/ROS接口/编码的静态索引，按本常量字面值解释。
 *
 * 它只是生成时目录关联，不读取文件、不验证当前加载schema或运行兼容性。
原声明类型：constexpr const char *；初始化表达式：= "dp.crash.CrashAnnounce.raw_fixed.v1"。
 */

/**
 * @var dp::protocol::legacy::kDpProtocolLegacyPayloadDpCrashCrashAnnounceRawFixedV1Canonical
 * @brief 旧payload到canonical schema、原SDK头或结构名的静态索引。
 *
 * 只说明历史来源/投影，不把两者ABI视为一致，不读取该源码文件。
原声明类型：constexpr const char *；初始化表达式：= "dp.crash.CrashAnnounce"。
 */

/**
 * @var dp::protocol::legacy::kDpProtocolLegacyPayloadDpCrashCrashAnnounceRawFixedV1SourceHeader
 * @brief 旧payload到canonical schema、原SDK头或结构名的静态索引。
 *
 * 只说明历史来源/投影，不把两者ABI视为一致，不读取该源码文件。
原声明类型：constexpr const char *；初始化表达式：= "libraries/dp_crash/include/dp_crash_types.h"。
 */

/**
 * @var dp::protocol::legacy::kDpProtocolLegacyPayloadDpCrashCrashAnnounceRawFixedV1StructDpCrashAnnounceT
