 * @brief 前一有界数组/文本的有效字节数；独立字段须由caller保证不超过真实数组容量，encoder并非总会检查。
 *
 * 实际声明类型：size_t。 getter/字段访问不会自动采集新设备数据。
 */

/**
 * @var dp_protocol_pb_writer_t::ptr
 * @brief 借用的缓冲游标指针；writer指向可写区域，reader指向只读区域，不负责内存释放。
 *
 * 实际声明类型：uint8_t *。 getter/字段访问不会自动采集新设备数据。
 */

/**
 * @var dp_protocol_pb_writer_t::len
 * @brief 当前writer已写/reader剩余字节计数；不是分配容量。
 *
 * 实际声明类型：size_t。 getter/字段访问不会自动采集新设备数据。
 */

/**
 * @var dp_protocol_pb_writer_t::cap
 * @brief writer可写缓冲总字节容量；caller须保证真实内存范围。
 *
 * 实际声明类型：size_t。 getter/字段访问不会自动采集新设备数据。
 */

/**
 * @var dp_protocol_pb_reader_t::ptr
 * @brief 借用的缓冲游标指针；writer指向可写区域，reader指向只读区域，不负责内存释放。
 *
 * 实际声明类型：const uint8_t *。 getter/字段访问不会自动采集新设备数据。
 */

/**
 * @var dp_protocol_pb_reader_t::len
 * @brief 当前writer已写/reader剩余字节计数；不是分配容量。
 *
 * 实际声明类型：size_t。 getter/字段访问不会自动采集新设备数据。
 */

/**
 * @fn static bool dp_protocol_pb_write_byte(dp_protocol_pb_writer_t *w, uint8_t value)
 * @brief 向writer编码Protobuf byte。
 *
 * 查writer非空及len<cap后写1字节；ptr真实容量由caller保证。 writer及缓冲为借用，不分配或释放。
 * @param w 非空借用writer，ptr指向cap可写字节且len不超过cap；操作可部分推进。
 * @param value 待存标量或视图，单位/身份含义与对应字段一致。
 * @return 成功true，容量/参数失败false，可部分写。
 */

/**
 * @fn static bool dp_protocol_pb_write_varint(dp_protocol_pb_writer_t *w, uint64_t value)
 * @brief 向writer编码Protobuf varint。
 *
 * 按base128输出uint64，至少1字节，最多10；容量不足可留下前缀/推进len，不回滚。 writer及缓冲为借用，不分配或释放。
 * @param w 非空借用writer，ptr指向cap可写字节且len不超过cap；操作可部分推进。
 * @param value 待存标量或视图，单位/身份含义与对应字段一致。
 * @return 成功true，容量/参数失败false，可部分写。
 */

/**
 * @fn static bool dp_protocol_pb_write_key(dp_protocol_pb_writer_t *w, uint32_t tag, uint8_t wire_type)
 * @brief 向writer编码Protobuf key。
 *
 * 输出(tag<<3)|wire_type的varint，不独立检查tag非零或wire_type合法。 writer及缓冲为借用，不分配或释放。
 * @param w 非空借用writer，ptr指向cap可写字节且len不超过cap；操作可部分推进。
 * @param tag TLV或Protobuf字段数值tag，不是schema/interface ID。
 * @param wire_type Protobuf wire类型原值，低层只支持其实现分支。
 * @return 成功true，容量/参数失败false，可部分写。
 */

/**
 * @fn static bool dp_protocol_pb_write_bytes(dp_protocol_pb_writer_t *w, uint32_t tag, const void *data, size_t data_len)
 * @brief 向writer编码Protobuf bytes。
 *
 * 先写key与长度，再查payload容量、复制；容量失败可已写头且推进len。data仅非零长度要求非空，不核来源数组真实长度。 writer及缓冲为借用，不分配或释放。
 * @param w 非空借用writer，ptr指向cap可写字节且len不超过cap；操作可部分推进。
 * @param tag TLV或Protobuf字段数值tag，不是schema/interface ID。
 * @param data 原始字节借用指针；get_bytes的指针输出借用输入寿命，write不保留。
 * @param data_len 字节数或读取长度输出，见指针类型；不是数组元素条数。
 * @return 成功true，容量/参数失败false，可部分写。
 */

/**
 * @fn static bool dp_protocol_pb_write_string(dp_protocol_pb_writer_t *w, uint32_t tag, const char *data, size_t data_len)
 * @brief 向writer编码Protobuf string。
 *
 * 直接按显式长度调用write_bytes，无UTF-8/NUL/命令合法性检查。 writer及缓冲为借用，不分配或释放。
 * @param w 非空借用writer，ptr指向cap可写字节且len不超过cap；操作可部分推进。
 * @param tag TLV或Protobuf字段数值tag，不是schema/interface ID。
 * @param data 原始字节借用指针；get_bytes的指针输出借用输入寿命，write不保留。
 * @param data_len 字节数或读取长度输出，见指针类型；不是数组元素条数。
 * @return 成功true，容量/参数失败false，可部分写。
 */

/**
 * @fn static bool dp_protocol_pb_write_uint32(dp_protocol_pb_writer_t *w, uint32_t tag, uint32_t value)
 * @brief 向writer编码Protobuf uint32。
 *
 * 写wire0 key与uint32 varint。 writer及缓冲为借用，不分配或释放。
 * @param w 非空借用writer，ptr指向cap可写字节且len不超过cap；操作可部分推进。
 * @param tag TLV或Protobuf字段数值tag，不是schema/interface ID。
 * @param value 待存标量或视图，单位/身份含义与对应字段一致。
 * @return 成功true，容量/参数失败false，可部分写。
 */

/**
 * @fn static bool dp_protocol_pb_write_int32(dp_protocol_pb_writer_t *w, uint32_t tag, int32_t value)
 * @brief 向writer编码Protobuf int32。
 *
 * 负int32先符号扩展到uint64，采用Protobuf int32长varint，不是ZigZag sint32。 writer及缓冲为借用，不分配或释放。
 * @param w 非空借用writer，ptr指向cap可写字节且len不超过cap；操作可部分推进。
 * @param tag TLV或Protobuf字段数值tag，不是schema/interface ID。
 * @param value 待存标量或视图，单位/身份含义与对应字段一致。
 * @return 成功true，容量/参数失败false，可部分写。
 */

/**
 * @fn static bool dp_protocol_pb_write_bool(dp_protocol_pb_writer_t *w, uint32_t tag, bool value)
 * @brief 向writer编码Protobuf bool。
 *
 * 写wire0 key与0/1 varint，不产生业务动作。 writer及缓冲为借用，不分配或释放。
 * @param w 非空借用writer，ptr指向cap可写字节且len不超过cap；操作可部分推进。
 * @param tag TLV或Protobuf字段数值tag，不是schema/interface ID。
 * @param value 待存标量或视图，单位/身份含义与对应字段一致。
 * @return 成功true，容量/参数失败false，可部分写。
 */

/**
 * @fn static bool dp_protocol_pb_read_varint(dp_protocol_pb_reader_t *r, uint64_t *out)
 * @brief 从reader消耗最多64位base128 varint。
 *
 * 推进ptr/len，即使不完整也不回滚；未作最短形式/第10字节高位溢出严格检查，不能当规范化或认证解析。
 * @param r 非空借用reader，ptr覆盖len可读字节；失败可消耗前缀。
 * @param out 借用结果对象/缓冲；C decoder可能清零后部分写，varint只有成功写标量。
 * @return 完整终止字节时true并写out，否则false。
 */

/**
 * @fn static bool dp_protocol_pb_read_key(dp_protocol_pb_reader_t *r, uint32_t *tag, uint8_t *wire_type)
 * @brief 读Protobuf key并拆tag/wire_type。
 *
 * 先消耗varint再查输出指针；tag只要求非零，超宽值有类型截断；不核schema字段号。
 * @param r 非空借用reader，ptr覆盖len可读字节；失败可消耗前缀。
 * @param tag TLV或Protobuf字段数值tag，不是schema/interface ID。
 * @param wire_type Protobuf wire类型原值，低层只支持其实现分支。
 * @return 可读且tag非零true，否则false。
 */

/**
 * @fn static bool dp_protocol_pb_read_len(dp_protocol_pb_reader_t *r, dp_protocol_pb_reader_t *sub)
 * @brief 读取长度并形成借用子reader。
 *
 * 长度不超过当前剩余字节才借用子段，父reader前移；失败可能已经消耗长度varint，不回滚。
 * @param r 非空借用reader，ptr覆盖len可读字节；失败可消耗前缀。
 * @param sub 借用子reader输出，其ptr仍指向父输入内存。
 * @return 有效有界子段true，否则false。
 */

/**
 * @fn static bool dp_protocol_pb_skip(dp_protocol_pb_reader_t *r, uint8_t wire_type)
 * @brief 跳过当前未知Protobuf字段。
 *
 * 仅支持wire type0 varint和2 length-delimited；固定32/64位及group不支持。
 * @param r 非空借用reader，ptr覆盖len可读字节；失败可消耗前缀。
 * @param wire_type Protobuf wire类型原值，低层只支持其实现分支。
 * @return 成功消耗字段true；其它wire type/截断false。
 */

/**
 * @fn static bool dp_protocol_pb_copy_string(dp_protocol_pb_reader_t *r, char *dst, size_t dst_cap, size_t *dst_len)
 * @brief 读取length-delimited字节并复制成NUL字符串。
 *
 * 要求sub.len严格小于dst_cap以留终止位；不验证UTF-8或内嵌NUL，父reader可能先前移后报目标容量不足。
 * @param r 非空借用reader，ptr覆盖len可读字节；失败可消耗前缀。
 * @param dst 借用目标数组，caller保证dst_cap真实容量。
 * @param dst_cap 目标字节容量；字符串需要额外终止NUL空间。
 * @param dst_len 成功复制字节数输出，不含终止NUL。
 * @return 成功true并写dst_len与终止NUL；失败false。
 */

/**
 * @fn static bool dp_protocol_pb_copy_bytes(dp_protocol_pb_reader_t *r, uint8_t *dst, size_t dst_cap, size_t *dst_len)
 * @brief 复制length-delimited原始字节。
 *
 * 允许长度等于dst_cap，不追加NUL；父reader不回滚，目标独立拥有拷贝。
