 * @return 底层dp_protocol_codec_status_t原样返回。
 */

/**
 * @fn static dp_protocol_codec_status_t dp_protocol_offline_log_file_response_dispatch_decode(const uint8_t *input, size_t input_size, void *message)
 * @brief 按分发表既定真实类型转发编码/解码。
