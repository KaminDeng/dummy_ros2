/**
 * @fn static size_t dp_protocol_bridge_strnlen(const char *text, size_t capacity)
 * @brief 有界寻找第一个NUL。
 *
 * 最多读capacity字节；不检查text空指针，满长无NUL仍返回capacity。
 * @param text 借用NUL终止文本，调用期间存活；不会保留或释放。
 * @param capacity 借用缓冲实际容量字节数；不分配内存。
 * @return 首个NUL偏移或capacity。
 */

/**
 * @fn static int dp_protocol_bridge_put_key(uint8_t *output, size_t capacity, size_t *offset, uint32_t tag, uint32_t wire_type)
 * @brief 执行桥转换的局部字节步骤：put_key。
 *
 * 将(tag<<3)|wire_type作为uint32 varint写出，不核tag/类型语义。 无网络、文件或设备副作用。
 * @param output 借用可写缓冲或结果对象；具体角色由函数签名/本段流程说明，返回后不保留。
