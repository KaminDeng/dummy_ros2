 */

/**
 * @var k_dp_protocol_codec_dispatch_table
 * @brief 六行已实现schema到手写Protobuf函数指针表。
 *
 * FileTransferRpc/FileRequest复用request decoder，FileResponse用response；未列出的schema不自动转TLV/raw，void类型须caller匹配。
原声明类型：const ；初始化表达式：。
 */

/**
 * @fn static dp_protocol_codec_status_t dp_protocol_encode(dp_protocol_profile_t profile, const char *schema, const void *message, uint8_t *output, size_t output_capacity, size_t *output_size)
 * @brief 按profile和精确schema选择已实现的encoder。
 *
 * 仅两Protobuf profile查6行分发表；仅命令request/response/ack及文件请求/响应投影，未列schema返回UNSUPPORTED且可清长度。void message必须与schema真实类型匹配；不是任意schema通用生成codec。
 * @param profile codec profile枚举；Tiny raw在通用分发中未实现，不等同TLV profile位。
 * @param schema 借用NUL终止schema文本，须精确匹配已实现分发表。
 * @param message 借用消息值对象；const为读入，非const为写入；caller保证正确类型和完整内存。
 * @param output 借用可写缓冲或结果对象；具体角色由函数签名/本段流程说明，返回后不保留。
 * @param output_capacity 输出实际可写字节容量；不含任何自动扩容。
 * @param output_size 根据签名传入精确固定wire字节数，或输出成功使用字节数的指针；见本函数流程。
 * @return 被选encoder结果或UNSUPPORTED；不执行IO。
 */

/**
 * @fn static dp_protocol_codec_status_t dp_protocol_decode(dp_protocol_profile_t profile, const char *schema, const uint8_t *input, size_t input_size, void *message)
 * @brief 按profile/schema分发到已有decoder。
 *
 * 两Protobuf profile才查表；未知schema/profile直接UNSUPPORTED，不修改目标。选中decoder可能部分改写目标；void*须类型匹配，不做RTTI。
 * @param profile codec profile枚举；Tiny raw在通用分发中未实现，不等同TLV profile位。
 * @param schema 借用NUL终止schema文本，须精确匹配已实现分发表。
 * @param input 借用只读输入缓冲，调用期间须覆盖声明的字节范围；不保留指针。
 * @param input_size 输入有效字节数，caller须保证与真实可读范围一致。
 * @param message 借用消息值对象；const为读入，非const为写入；caller保证正确类型和完整内存。
 * @return 所选decoder结果或UNSUPPORTED。
 */

/**
 * @fn static dp_protocol_codec_status_t dp_protocol_try_native_encode(dp_protocol_profile_t profile, const char *schema, const void *message, uint8_t *output, size_t output_capacity, size_t *output_size)
 * @brief 转发到相同profile/schema分发encoder。
 *
 * 名字native不代表会自动raw-fixed编码；实现只调用dp_protocol_encode。
 * @param profile codec profile枚举；Tiny raw在通用分发中未实现，不等同TLV profile位。
 * @param schema 借用NUL终止schema文本，须精确匹配已实现分发表。
 * @param message 借用消息值对象；const为读入，非const为写入；caller保证正确类型和完整内存。
 * @param output 借用可写缓冲或结果对象；具体角色由函数签名/本段流程说明，返回后不保留。
 * @param output_capacity 输出实际可写字节容量；不含任何自动扩容。
 * @param output_size 根据签名传入精确固定wire字节数，或输出成功使用字节数的指针；见本函数流程。
 * @return 完全沿用dp_protocol_encode状态。
 */

