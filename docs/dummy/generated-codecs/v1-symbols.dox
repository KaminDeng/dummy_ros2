/**
 * @namespace dp::protocol::dummy_robot_v1
 * @brief 本提取配置独立选中的1.0协议命名空间。
 *
 * 同名v2命名空间在2.4/2.5/fixture中不能合并INPUT；对象类型不是许可或控制会话。
 */

/**
 * @enum dp::protocol::dummy_robot_v1::CodecResult
 * @brief 固定codec局部结果码：kOk=0或kInvalidArgument。
 *
 * kOk仅表示该函数实现的格式门通过，不等管理操作接纳、页链验证、实机动作成功；枚举不携详细失败原因。
 */

/**
 * @fn void dp::protocol::dummy_robot_v1::detail::put_le8(uint8_t value, uint8_t* output)
 * @brief 将无符号8位整数按低字节在先写入。
 *
 * 内部循环只位移/写字节，无指针/容量检查；caller须提供至少1个可写字节。不是网络发送或对象整体memcpy。
 * @param value 要编码的无符号位值，无业务单位。
 * @param output 借用可写缓冲，函数返回后不保留指针。
 * @return 无返回值；写入1字节。
 */

/**
 * @fn uint8_t dp::protocol::dummy_robot_v1::detail::get_le8(const uint8_t* input)
 * @brief 从低字节在先的1字节拼无符号8位整数。
 *
 * 不查指针/容量；仅返回位模式，double等由调用方memcpy恢复，不解析业务单位。
 * @param input 至少1个可读字节的借用指针，返回后不保留。
 * @return 拼得的无符号整数值。
 */

/**
 * @fn void dp::protocol::dummy_robot_v1::detail::put_le16(uint16_t value, uint8_t* output)
 * @brief 将无符号16位整数按低字节在先写入。
 *
 * 内部循环只位移/写字节，无指针/容量检查；caller须提供至少2个可写字节。不是网络发送或对象整体memcpy。
 * @param value 要编码的无符号位值，无业务单位。
 * @param output 借用可写缓冲，函数返回后不保留指针。
 * @return 无返回值；写入2字节。
 */

/**
 * @fn uint16_t dp::protocol::dummy_robot_v1::detail::get_le16(const uint8_t* input)
 * @brief 从低字节在先的2字节拼无符号16位整数。
 *
 * 不查指针/容量；仅返回位模式，double等由调用方memcpy恢复，不解析业务单位。
 * @param input 至少2个可读字节的借用指针，返回后不保留。
 * @return 拼得的无符号整数值。
 */

/**
 * @fn void dp::protocol::dummy_robot_v1::detail::put_le32(uint32_t value, uint8_t* output)
 * @brief 将无符号32位整数按低字节在先写入。
 *
 * 内部循环只位移/写字节，无指针/容量检查；caller须提供至少4个可写字节。不是网络发送或对象整体memcpy。
 * @param value 要编码的无符号位值，无业务单位。
 * @param output 借用可写缓冲，函数返回后不保留指针。
 * @return 无返回值；写入4字节。
 */

/**
 * @fn uint32_t dp::protocol::dummy_robot_v1::detail::get_le32(const uint8_t* input)
 * @brief 从低字节在先的4字节拼无符号32位整数。
 *
 * 不查指针/容量；仅返回位模式，double等由调用方memcpy恢复，不解析业务单位。
 * @param input 至少4个可读字节的借用指针，返回后不保留。
 * @return 拼得的无符号整数值。
 */

/**
 * @fn void dp::protocol::dummy_robot_v1::detail::put_le64(uint64_t value, uint8_t* output)
 * @brief 将无符号64位整数按低字节在先写入。
 *
 * 内部循环只位移/写字节，无指针/容量检查；caller须提供至少8个可写字节。不是网络发送或对象整体memcpy。
 * @param value 要编码的无符号位值，无业务单位。
 * @param output 借用可写缓冲，函数返回后不保留指针。
 * @return 无返回值；写入8字节。
 */

/**
 * @fn uint64_t dp::protocol::dummy_robot_v1::detail::get_le64(const uint8_t* input)
 * @brief 从低字节在先的8字节拼无符号64位整数。
 *
 * 不查指针/容量；仅返回位模式，double等由调用方memcpy恢复，不解析业务单位。
 * @param input 至少8个可读字节的借用指针，返回后不保留。
 * @return 拼得的无符号整数值。
 */

/**
 * @class dp::protocol::dummy_robot_v1::DummyDeviceStatusV1
 * @brief 设备状态/能力及终态摘要值对象（wire 297字节，schema 1.0）。
 *
 * 本对象拥有所有固定字段/数组，默认全零并不构成有效schema/身份。getter不加锁；同一对象并发读写须调用方同步。数组getter返回内部const数组引用，寿命至对象销毁，后续setter/赋值会改变观察值；需要稳定快照时主动复制。setter只复制，不验证数值、掩码、许可或状态机。
 */

/**
 * @fn dp::protocol::dummy_robot_v1::DummyDeviceStatusV1::schema_major() const
 * @brief 读取wire主版本号，无单位；对象默认0，调用方须显式填支持版本，setter不自动采用常量。 本family要求1.0。
 *
 * wire offset 0，占2字节。 不做解码/状态判定或业务校验。
 * @return 字段当前值的拷贝。
 */

/**
 * @fn void dp::protocol::dummy_robot_v1::DummyDeviceStatusV1::set_schema_major(uint16_t value)
 * @brief 写入wire主版本号，无单位；对象默认0，调用方须显式填支持版本，setter不自动采用常量。 本family要求1.0。
 *
 * wire offset 0，占2字节。 直接赋值，不调用设备、不更新其它字段。
 * @param value 同上述单位/身份语义的输入值。
 * @return 无返回值；仅修改当前消息对象。
 */

/**
 * @var dp::protocol::dummy_robot_v1::DummyDeviceStatusV1::schema_major_
 * @brief 拥有式字段存储：wire主版本号，无单位；对象默认0，调用方须显式填支持版本，setter不自动采用常量。 本family要求1.0。
 *
 * wire offset 0，占2字节。 这是私有C++存储，sizeof含填充且不可当wire结构直接传；通过getter/setter访问。
 */

/**
 * @fn dp::protocol::dummy_robot_v1::DummyDeviceStatusV1::schema_minor() const
 * @brief 读取wire次版本号，无单位；解码要求本头精确版本，不因同主版本就接受其它minor。 本family要求1.0。
 *
 * wire offset 2，占2字节。 不做解码/状态判定或业务校验。
 * @return 字段当前值的拷贝。
 */

/**
 * @fn void dp::protocol::dummy_robot_v1::DummyDeviceStatusV1::set_schema_minor(uint16_t value)
 * @brief 写入wire次版本号，无单位；解码要求本头精确版本，不因同主版本就接受其它minor。 本family要求1.0。
 *
 * wire offset 2，占2字节。 直接赋值，不调用设备、不更新其它字段。
 * @param value 同上述单位/身份语义的输入值。
 * @return 无返回值；仅修改当前消息对象。
 */

/**
 * @var dp::protocol::dummy_robot_v1::DummyDeviceStatusV1::schema_minor_
 * @brief 拥有式字段存储：wire次版本号，无单位；解码要求本头精确版本，不因同主版本就接受其它minor。 本family要求1.0。
 *
 * wire offset 2，占2字节。 这是私有C++存储，sizeof含填充且不可当wire结构直接传；通过getter/setter访问。
 */

/**
 * @fn dp::protocol::dummy_robot_v1::DummyDeviceStatusV1::device_id() const
 * @brief 读取设备128bit身份的16个原字节，不是零结尾字符串；codec只搬运，不查USB/UID或认证来源。
 *
 * wire offset 4，占16字节，共16元素。 不做解码/状态判定或业务校验。
 * @return 本对象内部const 16元素数组引用；对象必须存活，setter后所见值可变。
 */

/**
 * @fn void dp::protocol::dummy_robot_v1::DummyDeviceStatusV1::set_device_id(const uint8_t (&value)[16])
 * @brief 写入设备128bit身份的16个原字节，不是零结尾字符串；codec只搬运，不查USB/UID或认证来源。
 *
 * wire offset 4，占16字节，共16元素。 使用memcpy复制完整固定数组，不保存输入引用；数组长度由C++形参约束。
 * @param value 同上述单位/身份语义的16元素输入数组；调用期间须有效。
 * @return 无返回值；仅修改当前消息对象。
 */

/**
 * @var dp::protocol::dummy_robot_v1::DummyDeviceStatusV1::device_id_
